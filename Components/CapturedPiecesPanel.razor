<div class="captured-pieces @(IsOpponent ? "opponent" : "player")">
    <div class="captured-label">@(IsOpponent ? "相手の持ち駒" : "自分の持ち駒")</div>
    <div class="captured-list">
        @foreach (var pieceType in PieceOrder)
        {
            var count = Pieces.GetCount(pieceType);
            if (count > 0)
            {
                var isSelected = SelectedPiece == pieceType;
                <div class="captured-piece @(isSelected ? "selected" : "") @(IsOpponent ? "" : "clickable")"
                     @onclick="() => OnClick(pieceType)">
                    <span class="piece-char @(IsOpponent ? "gote" : "")">@pieceType.GetCapturedChar()</span>
                    @if (count > 1)
                    {
                        <span class="piece-count">@count</span>
                    }
                </div>
            }
        }
        @if (!Pieces.GetAll().Any())
        {
            <div class="no-pieces">なし</div>
        }
    </div>
</div>
