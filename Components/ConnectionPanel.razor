<div class="connection-panel">
    <h3>P2P接続</h3>

    <div class="connection-status">
        状態: <span class="status-@ConnectionState.ToString().ToLower()">@GetStatusText()</span>
    </div>

    @if (ConnectionState == Services.ConnectionState.Disconnected)
    {
        @if (!SelectedPlayer.HasValue)
        {
            <div class="player-selection">
                <h4>あなたの手番を選択してください</h4>
                <div class="player-buttons">
                    <button class="btn primary large" @onclick="() => SelectPlayer(Player.Sente)">
                        先手（黒）
                        <span class="hint">ルームを作成します</span>
                    </button>
                    <button class="btn primary large" @onclick="() => SelectPlayer(Player.Gote)">
                        後手（白）
                        <span class="hint">ルームに参加します</span>
                    </button>
                </div>
            </div>
        }
        else if (SelectedPlayer == Player.Sente)
        {
            <div class="connection-options">
                <div class="option-section">
                    <h4>対局を開始する（先手）</h4>
                    <button class="btn secondary small" @onclick="ResetSelection">← 戻る</button>

                    @if (string.IsNullOrEmpty(RoomId))
                    {
                        <button class="btn primary" @onclick="CreateRoom" disabled="@IsProcessing">
                            @(IsProcessing ? "作成中..." : "ルームを作成")
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(RoomId))
                    {
                        <div class="room-code-section">
                            <label>このルームコードを相手に伝えてください：</label>
                            <div class="room-code-display">
                                <span class="room-code">@RoomId</span>
                                <button class="btn small" @onclick="() => CopyToClipboard(RoomId)">コピー</button>
                            </div>
                            <p class="hint">相手がこのコードを入力すると接続されます</p>
                        </div>
                    }
                </div>
            </div>
        }
        else if (SelectedPlayer == Player.Gote)
        {
            <div class="connection-options">
                <div class="option-section">
                    <h4>対局に参加する（後手）</h4>
                    <button class="btn secondary small" @onclick="ResetSelection">← 戻る</button>

                    <div class="room-code-section">
                        <label>相手から受け取ったルームコードを入力：</label>
                        <div class="room-code-input">
                            <input type="text" @bind="InputRoomId" @bind:event="oninput"
                                   placeholder="例: ABC123" maxlength="6"
                                   style="text-transform: uppercase;" />
                            <button class="btn primary" @onclick="JoinRoom"
                                    disabled="@(InputRoomId.Length < 6 || IsProcessing)">
                                @(IsProcessing ? "接続中..." : "参加")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @if (ConnectionState == Services.ConnectionState.Connecting)
    {
        <div class="connecting">
            @if (!string.IsNullOrEmpty(RoomId) && SelectedPlayer == Player.Sente)
            {
                <div class="room-code-section">
                    <label>ルームコード：</label>
                    <div class="room-code-display">
                        <span class="room-code">@RoomId</span>
                        <button class="btn small" @onclick="() => CopyToClipboard(RoomId)">コピー</button>
                    </div>
                </div>
            }
            <div class="spinner"></div>
            <p>相手の接続を待っています...</p>
        </div>
    }

    @if (ConnectionState == Services.ConnectionState.Connected)
    {
        <div class="connected">
            <p>接続完了！</p>
            <button class="btn danger" @onclick="Disconnect">切断</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="error-message">@ErrorMessage</div>
    }
</div>
