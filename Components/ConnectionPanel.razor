@using ShogiGame.Services
@using ShogiGame.Models
@inject IJSRuntime JS

<div class="connection-panel">
    <h3>P2P接続</h3>

    <div class="connection-status">
        状態: <span class="status-@ConnectionState.ToString().ToLower()">@GetStatusText()</span>
    </div>

    @if (ConnectionState == Services.ConnectionState.Disconnected)
    {
        @if (!SelectedPlayer.HasValue)
        {
            <div class="player-selection">
                <h4>あなたの手番を選択してください</h4>
                <div class="player-buttons">
                    <button class="btn primary large" @onclick="() => SelectPlayer(Player.Sente)">
                        先手（黒）
                        <span class="hint">ルームを作成します</span>
                    </button>
                    <button class="btn primary large" @onclick="() => SelectPlayer(Player.Gote)">
                        後手（白）
                        <span class="hint">ルームに参加します</span>
                    </button>
                </div>
            </div>
        }
        else if (SelectedPlayer == Player.Sente)
        {
            <div class="connection-options">
                <div class="option-section">
                    <h4>対局を開始する（先手）</h4>
                    <button class="btn secondary small" @onclick="ResetSelection">← 戻る</button>

                    @if (string.IsNullOrEmpty(RoomId))
                    {
                        <button class="btn primary" @onclick="CreateRoom" disabled="@IsProcessing">
                            @(IsProcessing ? "作成中..." : "ルームを作成")
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(RoomId))
                    {
                        <div class="room-code-section">
                            <label>このルームコードを相手に伝えてください：</label>
                            <div class="room-code-display">
                                <span class="room-code">@RoomId</span>
                                <button class="btn small" @onclick="() => CopyToClipboard(RoomId)">コピー</button>
                            </div>
                            <p class="hint">相手がこのコードを入力すると接続されます</p>
                        </div>
                    }
                </div>
            </div>
        }
        else if (SelectedPlayer == Player.Gote)
        {
            <div class="connection-options">
                <div class="option-section">
                    <h4>対局に参加する（後手）</h4>
                    <button class="btn secondary small" @onclick="ResetSelection">← 戻る</button>

                    <div class="room-code-section">
                        <label>相手から受け取ったルームコードを入力：</label>
                        <div class="room-code-input">
                            <input type="text" @bind="InputRoomId" @bind:event="oninput"
                                   placeholder="例: ABC123" maxlength="6"
                                   style="text-transform: uppercase;" />
                            <button class="btn primary" @onclick="JoinRoom"
                                    disabled="@(InputRoomId.Length < 6 || IsProcessing)">
                                @(IsProcessing ? "接続中..." : "参加")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @if (ConnectionState == Services.ConnectionState.Connecting)
    {
        <div class="connecting">
            @if (!string.IsNullOrEmpty(RoomId) && SelectedPlayer == Player.Sente)
            {
                <div class="room-code-section">
                    <label>ルームコード：</label>
                    <div class="room-code-display">
                        <span class="room-code">@RoomId</span>
                        <button class="btn small" @onclick="() => CopyToClipboard(RoomId)">コピー</button>
                    </div>
                </div>
            }
            <div class="spinner"></div>
            <p>相手の接続を待っています...</p>
        </div>
    }

    @if (ConnectionState == Services.ConnectionState.Connected)
    {
        <div class="connected">
            <p>接続完了！</p>
            <button class="btn danger" @onclick="Disconnect">切断</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="error-message">@ErrorMessage</div>
    }
</div>

@code {
    [Parameter] public WebRtcService WebRtcService { get; set; } = null!;
    [Parameter] public EventCallback<bool> OnConnected { get; set; }
    [Parameter] public EventCallback<bool> OnPlayerAssigned { get; set; }

    private ConnectionState ConnectionState => WebRtcService?.State ?? Services.ConnectionState.Disconnected;

    private Player? SelectedPlayer { get; set; }
    private string RoomId { get; set; } = "";
    private string InputRoomId { get; set; } = "";
    private string ErrorMessage { get; set; } = "";
    private bool IsProcessing { get; set; }
    private bool HasNotifiedConnected { get; set; }

    private void SelectPlayer(Player player) => SelectedPlayer = player;

    private void ResetSelection()
    {
        SelectedPlayer = null;
        ClearAll();
    }

    protected override void OnInitialized()
    {
        if (WebRtcService is not null)
        {
            WebRtcService.OnStateChanged += OnStateChanged;
        }
    }

    private void OnStateChanged(ConnectionState state)
    {
        InvokeAsync(async () =>
        {
            if (state == Services.ConnectionState.Connected && !HasNotifiedConnected)
            {
                HasNotifiedConnected = true;
                await OnConnected.InvokeAsync(true);
            }
            StateHasChanged();
        });
    }

    private async Task CreateRoom()
    {
        try
        {
            IsProcessing = true;
            ErrorMessage = "";
            StateHasChanged();
            RoomId = await WebRtcService.CreateRoomAsync();
            await OnPlayerAssigned.InvokeAsync(true);  // Sente
        }
        catch (Exception ex)
        {
            ErrorMessage = $"エラー: {ex.Message}";
            Console.WriteLine($"CreateRoom error: {ex}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task JoinRoom()
    {
        try
        {
            IsProcessing = true;
            ErrorMessage = "";
            StateHasChanged();
            await WebRtcService.JoinRoomAsync(InputRoomId.ToUpperInvariant());
            await OnPlayerAssigned.InvokeAsync(false);  // Gote
        }
        catch (Exception ex)
        {
            ErrorMessage = $"エラー: {ex.Message}";
            Console.WriteLine($"JoinRoom error: {ex}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task Disconnect()
    {
        await WebRtcService.DisconnectAsync();
        HasNotifiedConnected = false;
        ClearAll();
    }

    private void ClearAll()
    {
        RoomId = "";
        InputRoomId = "";
        ErrorMessage = "";
    }

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    private string GetStatusText() => ConnectionState switch
    {
        Services.ConnectionState.Disconnected => "未接続",
        Services.ConnectionState.Connecting => "接続中",
        Services.ConnectionState.Connected => "接続済み",
        _ => "不明"
    };

    public void Dispose()
    {
        if (WebRtcService is not null)
        {
            WebRtcService.OnStateChanged -= OnStateChanged;
        }
    }
}
