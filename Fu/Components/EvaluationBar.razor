@using Fu.Core.Models
@using Fu.Services
@inject IJSRuntime JSRuntime

<div class="evaluation-container">
    @if (!EngineService.IsAvailable)
    {
        <div class="evaluation-unavailable">
            <span>評価機能を有効化中...</span>
        </div>
    }
    else
    {
        @if (ShowEvaluationValue)
        {
            <div class="evaluation-bar">
                <div class="evaluation-fill" style="height: @FillPercentage%"></div>
                <div class="evaluation-center"></div>
            </div>
        }
        <div class="evaluation-info">
            @if (ShowAdvantage)
            {
                <div class="advantage-indicator @(AdvantageClass)">
                    @AdvantageText
                </div>
            }
            @if (ShowEvaluationValue)
            {
                <div class="evaluation-value @(EvaluationClass)" title="@EvaluationHelp">
                    @EvaluationText
                    <span class="help-icon" title="@EvaluationGuide">?</span>
                </div>
            }
            @if (ShowHasMate && EngineService.MateIn is { } mate)
            {
                @* 詰みは手番視点: mate > 0 = 手番側勝ち, mate < 0 = 手番側負け *@
                var matePlayer = mate > 0 ? EngineService.MatePlayer : EngineService.MatePlayer.GetOpponent();
                var mateCount = Math.Abs(mate);
                var isSenteMate = matePlayer == Player.Sente;
                <div class="mate-info @(isSenteMate ? "sente-mate" : "gote-mate")">
                    @if (ShowMateCount)
                    {
                        @(isSenteMate ? $"先手{mateCount}手詰み" : $"後手{mateCount}手詰み")
                    }
                    else
                    {
                        @(isSenteMate ? "先手に詰みあり" : "後手に詰みあり")
                    }
                </div>
                @if (ShowMateSequence && !string.IsNullOrEmpty(EngineService.PrincipalVariation))
                {
                    <div class="mate-sequence">
                        <span class="mate-sequence-label">詰み手順:</span>
                        <span class="mate-sequence-moves">@FormatMateSequence(EngineService.PrincipalVariation)</span>
                    </div>
                }
            }
            else if (ShowHasMate && EngineService.IsThreatening)
            {
                @* 詰めろ: ThreateningPlayer が詰めろにかかっている *@
                var isSenteThreatened = EngineService.ThreateningPlayer == Player.Sente;
                <div class="threatening-info @(isSenteThreatened ? "sente-threatened" : "gote-threatened")" title="受けなければ次に詰む状態">
                    @if (ShowMateCount && EngineService.ThreateningMateIn is { } threatMate)
                    {
                        <span>@(isSenteThreatened ? "先手" : "後手")詰めろ (@(threatMate)手)</span>
                    }
                    else
                    {
                        <span>@(isSenteThreatened ? "先手" : "後手")詰めろ</span>
                    }
                </div>
            }
            @if (ShowCandidates && EngineService.Candidates.Count > 0)
            {
                <div class="candidates-list">
                    <div class="candidates-title">候補手</div>
                    @foreach (var candidate in EngineService.Candidates.Take(3))
                    {
                        <div class="candidate-item">
                            <span class="candidate-rank">@candidate.Rank.</span>
                            <span class="candidate-move">@FormatMoveWithPiece(candidate.Move, Board)</span>
                            <span class="candidate-eval @(GetEvalClass(candidate.Evaluation))">
                                @FormatEvaluation(candidate.Evaluation, candidate.MateIn)
                            </span>
                        </div>
                    }
                </div>
            }
            @if (ShowEvaluationValue && EngineService.Depth > 0)
            {
                <div class="evaluation-depth">深さ: @EngineService.Depth</div>
            }
            @if (EngineService.IsAnalyzing)
            {
                <div class="evaluation-analyzing">分析中...</div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ShogiEngineService EngineService { get; set; } = null!;

    [Parameter]
    public bool ShowAdvantage { get; set; } = true;

    [Parameter]
    public bool ShowEvaluationValue { get; set; } = true;

    [Parameter]
    public bool ShowHasMate { get; set; } = true;

    [Parameter]
    public bool ShowMateCount { get; set; } = true;

    [Parameter]
    public bool ShowCandidates { get; set; } = false;

    [Parameter]
    public bool ShowMateSequence { get; set; } = false;

    [Parameter]
    public Board? Board { get; set; }

    private int? Eval => EngineService.Evaluation;

    private int FillPercentage => Eval is { } eval
        ? 50 + (int)(Math.Clamp(eval, -2000, 2000) / 40.0)
        : 50;

    private string AdvantageText => Eval switch {
        null => "---",
        > 29000 => "先手勝勢",
        < -29000 => "後手勝勢",
        > 500 => "先手優勢",
        > 200 => "先手有利",
        < -500 => "後手優勢",
        < -200 => "後手有利",
        _ => "互角"
    };

    private string AdvantageClass => GetEvalClass(Eval);

    private string EvaluationText => Eval switch {
        null => "---",
        > 29000 => "先手勝ち",
        < -29000 => "後手勝ち",
        { } e => FormatPawnValue(e, "F1")
    };

    private string EvaluationHelp => Eval switch {
        null => "",
        > 29000 or < -29000 => "詰みが確定している状態",
        > 2000 or < -2000 => "ほぼ勝ち/負けが決まっている状態",
        > 1000 or < -1000 => "大きく有利/不利な状態",
        > 500 or < -500 => "かなり有利/不利な状態",
        > 300 or < -300 => "有利/不利な状態",
        > 100 or < -100 => "やや有利/不利な状態",
        _ => "ほぼ互角の状態"
    };

    private const string EvaluationGuide = @"【評価値の目安】
±0.0〜1.0: ほぼ互角
±1.0〜3.0: やや有利
±3.0〜5.0: 有利
±5.0〜10.0: かなり有利
±10.0〜20.0: 優勢〜勝勢
±20.0以上: ほぼ勝ち確定

※1.0 ≒ 歩1枚分の価値";

    private static string FormatPawnValue(int centipawn, string format)
    {
        var v = centipawn / 100.0;
        return v >= 0 ? $"+{v.ToString(format)}" : v.ToString(format);
    }

    private string EvaluationClass => GetEvalClass(Eval);

    private static string GetEvalClass(int? eval) => eval switch {
        > 500 => "sente-advantage",
        < -500 => "gote-advantage",
        _ => "even"
    };

    private static string FormatEvaluation(int? eval, int? mateIn) => mateIn switch {
        > 0 => $"#{mateIn}",
        < 0 => $"#-{-mateIn}",
        _ => eval switch {
            null => "---",
            > 29000 => "勝ち",
            < -29000 => "負け",
            { } e => FormatPawnValue(e, "F0")
        }
    };

    private static readonly string[] RowKanji = ["一", "二", "三", "四", "五", "六", "七", "八", "九"];

    private static string FormatMove(string usiMove)
    {
        if (string.IsNullOrEmpty(usiMove) || usiMove.Length < 4) return usiMove ?? "---";

        // 駒打ち（例: P*3d）
        if (usiMove[1] == '*') {
            var piece = usiMove[0] switch {
                'P' => "歩", 'L' => "香", 'N' => "桂", 'S' => "銀",
                'G' => "金", 'B' => "角", 'R' => "飛", _ => usiMove[0].ToString()
            };
            var toCol = 9 - (usiMove[2] - '1');
            var toRow = usiMove[3] - 'a';
            return $"{toCol}{RowKanji[toRow]}{piece}打";
        }

        // 通常の移動（例: 7g7f, 7g7f+）
        var fromCol = 9 - (usiMove[0] - '1');
        var fromRow = usiMove[1] - 'a';
        var toCol2 = 9 - (usiMove[2] - '1');
        var toRow2 = usiMove[3] - 'a';
        var promote = usiMove.Length > 4 && usiMove[4] == '+' ? "成" : "";
        return $"{toCol2}{RowKanji[toRow2]}{promote}({fromCol}{fromRow + 1})";
    }

    private static string FormatMateSequence(string pv)
    {
        if (string.IsNullOrEmpty(pv)) return "";

        var moves = pv.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var formatted = moves.Select((m, i) => $"{i + 1}.{FormatMove(m)}");
        return string.Join(" ", formatted);
    }

    private static string FormatMoveWithPiece(string usiMove, Board? board)
    {
        if (string.IsNullOrEmpty(usiMove) || usiMove.Length < 4) return usiMove ?? "---";

        // 通常の移動（例: 7g7f, 7g7f+）
        var fromCol = 8 - (usiMove[0] - '1');  // 内部座標: 0-8
        var fromRow = usiMove[1] - 'a';
        var toCol = 9 - (usiMove[2] - '1');    // 表示用: 1-9
        var toRow = usiMove[3] - 'a';

        // 駒打ち（例: P*3d）
        if (usiMove[1] == '*') {
            var piece = usiMove[0] switch {
                'P' => "歩", 'L' => "香", 'N' => "桂", 'S' => "銀",
                'G' => "金", 'B' => "角", 'R' => "飛", _ => usiMove[0].ToString()
            };
            return $"{toCol}{RowKanji[toRow]}{piece}打";
        }
        var promote = usiMove.Length > 4 && usiMove[4] == '+' ? "成" : "";

        // 盤面から駒の種類を取得
        var pieceName = "";
        if (board is not null) {
            var piece = board[fromCol, fromRow];
            if (piece is not null) {
                pieceName = piece.Type.GetCapturedChar();
            }
        }

        return $"{toCol}{RowKanji[toRow]}{pieceName}{promote}({9 - fromCol}{fromRow + 1})";
    }
}
