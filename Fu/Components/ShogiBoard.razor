<div class="shogi-container">
    <CapturedPiecesPanel
        Pieces="@(IsFlipped ? DisplaySenteCaptured : DisplayGoteCaptured)"
        Player="@(IsFlipped ? Player.Sente : Player.Gote)"
        IsOpponent="true"
        OnPieceSelected="OnCapturedPieceClick"
        SelectedPiece="@(IsSelectingDropTarget ? SelectedDropPiece : null)" />

    <div class="board-wrapper">
        <div class="col-labels top">
            @for (int c = 0; c < 9; c++)
            {
                var col = IsFlipped ? 8 - c : c;
                <span>@(9 - col)</span>
            }
        </div>

        <div class="board-with-rows">
            <div class="row-labels">
                @{
                    var rowChars = new[] { "一", "二", "三", "四", "五", "六", "七", "八", "九" };
                }
                @for (int r = 0; r < 9; r++)
                {
                    var row = IsFlipped ? 8 - r : r;
                    <span>@rowChars[row]</span>
                }
            </div>

            <div class="board" @onclick="OnBoardClick" @onclick:stopPropagation="true">
                @for (int r = 0; r < 9; r++)
                {
                    var displayRow = IsFlipped ? 8 - r : r;
                    <div class="board-row">
                        @for (int c = 0; c < 9; c++)
                        {
                            var displayCol = IsFlipped ? 8 - c : c;
                            var pos = new Position(displayCol, displayRow);
                            var piece = DisplayBoard[pos];
                            var isSelected = SelectedPosition == pos;
                            var isLegalMove = LegalMoves.Contains(pos);
                            var isLastMove = IsLastMovePosition(pos);

                            <div class="cell @(isSelected ? "selected" : "") @(isLegalMove ? "legal-move" : "") @(isLastMove ? "last-move" : "")"
                                 data-col="@displayCol" data-row="@displayRow"
                                 @onclick="() => OnCellClickAsync(pos)" @onclick:stopPropagation="true">
                                @if (piece != null)
                                {
                                    @* 後手視点(IsFlipped)では先手の駒を逆さま、先手視点では後手の駒を逆さまに *@
                                    var isUpsideDown = IsFlipped ? piece.Owner == Player.Sente : piece.Owner == Player.Gote;
                                    <div class="piece @(isUpsideDown ? "gote" : "") @(piece.Type.IsPromoted() ? "promoted" : "")">
                                        @piece.GetDisplayChar()
                                    </div>
                                }
                                @if (isLegalMove && piece == null)
                                {
                                    <div class="move-indicator"></div>
                                }
                            </div>
                        }
                    </div>
                }

                @* 候補手の矢印オーバーレイ *@
                @if (CandidateMoves?.Count > 0)
                {
                    var arrows = GetCandidateArrows().ToList();
                    <svg class="candidate-arrows-overlay" viewBox="0 0 450 450" preserveAspectRatio="none">
                        @for (var index = 0; index < arrows.Count; index++)
                        {
                            var arrow = arrows[index];
                            @if (arrow.IsDrop)
                            {
                                @* 駒打ちはマーカー（円）で表示 *@
                                var cx = arrow.ToCol * 50 + 25;
                                var cy = arrow.ToRow * 50 + 25;
                                var radius = 12 + arrow.StrokeWidth;
                                <circle cx="@cx" cy="@cy" r="@radius"
                                        fill="none" stroke="#2266cc" stroke-width="@arrow.StrokeWidth"
                                        opacity="0.7" />
                            }
                            else
                            {
                                @* 通常の移動は矢印で表示 *@
                                var x1 = arrow.FromCol * 50 + 25;
                                var y1 = arrow.FromRow * 50 + 25;
                                var x2 = arrow.ToCol * 50 + 25;
                                var y2 = arrow.ToRow * 50 + 25;

                                var dx = x2 - x1;
                                var dy = y2 - y1;
                                var length = Math.Sqrt(dx * dx + dy * dy);
                                if (length > 0)
                                {
                                    @* 矢印を少し短くして駒と重ならないようにする *@
                                    var shortenRatio = 15 / length;
                                    var adjX1 = x1 + dx * shortenRatio;
                                    var adjY1 = y1 + dy * shortenRatio;
                                    var adjX2 = x2 - dx * shortenRatio;
                                    var adjY2 = y2 - dy * shortenRatio;

                                    @* 矢印の鏃を計算 *@
                                    var arrowHeadLength = arrow.StrokeWidth * 2.5;
                                    var arrowHeadWidth = arrow.StrokeWidth * 1.5;
                                    var unitX = dx / length;
                                    var unitY = dy / length;
                                    var perpX = -unitY;
                                    var perpY = unitX;

                                    @* 鏃の付け根 *@
                                    var baseX = adjX2 - unitX * arrowHeadLength;
                                    var baseY = adjY2 - unitY * arrowHeadLength;

                                    @* 鏃の左右の点 *@
                                    var leftX = baseX + perpX * arrowHeadWidth;
                                    var leftY = baseY + perpY * arrowHeadWidth;
                                    var rightX = baseX - perpX * arrowHeadWidth;
                                    var rightY = baseY - perpY * arrowHeadWidth;

                                    @* 矢印の本体（線） *@
                                    <line x1="@adjX1.ToString("F1")" y1="@adjY1.ToString("F1")"
                                          x2="@baseX.ToString("F1")" y2="@baseY.ToString("F1")"
                                          stroke="#2266cc" stroke-width="@arrow.StrokeWidth"
                                          stroke-linecap="round"
                                          opacity="0.7" />

                                    @* 矢印の鏃（path） *@
                                    <path d="M @adjX2.ToString("F1") @adjY2.ToString("F1") L @leftX.ToString("F1") @leftY.ToString("F1") L @rightX.ToString("F1") @rightY.ToString("F1") Z"
                                          fill="#2266cc"
                                          opacity="0.7" />
                                }
                            }
                        }
                    </svg>
                }
            </div>
        </div>
    </div>

    <CapturedPiecesPanel
        Pieces="@(IsFlipped ? DisplayGoteCaptured : DisplaySenteCaptured)"
        Player="@(IsFlipped ? Player.Gote : Player.Sente)"
        IsOpponent="false"
        OnPieceSelected="OnCapturedPieceClick"
        SelectedPiece="@(IsSelectingDropTarget ? SelectedDropPiece : null)" />
</div>

@if (ShowPromotionDialog)
{
    <div class="promotion-dialog-overlay" @onclick="() => ShowPromotionDialog = false">
        <div class="promotion-dialog" @onclick:stopPropagation="true">
            <p>成りますか？</p>
            <button @onclick="() => CompleteMoveAsync(true)">成る</button>
            <button @onclick="() => CompleteMoveAsync(false)">不成</button>
        </div>
    </div>
}
