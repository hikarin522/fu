@using Fu.Core.Models

<div class="move-tree-view">
    @if (MoveTree is not null)
    {
        var branches = BuildBranches();
        @foreach (var branch in branches)
        {
            <div class="tree-branch" style="margin-left: @(branch.IndentLevel * IndentWidth)px">
                @foreach (var nodeInfo in branch.Nodes)
                {
                    <div class="tree-node @(IsCurrentNode(nodeInfo.Node) ? "current" : "") @(nodeInfo.IsBranchStart ? "branch-start" : "")"
                         @onclick="() => OnNodeClick(nodeInfo.Node)"
                         title="@(nodeInfo.Node?.Move.ToNotationWithFrom() ?? "")">
                        @if (nodeInfo.IsStart)
                        {
                            <span>開始局面</span>
                        }
                        else if (nodeInfo.Node is not null)
                        {
                            <span>@(nodeInfo.Node.Depth). @nodeInfo.Node.Move.ToNotationWithFrom()</span>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public MoveTree? MoveTree { get; set; }
    [Parameter] public IReadOnlyList<Move>? MoveHistory { get; set; }
    [Parameter] public int DisplayMoveIndex { get; set; }
    [Parameter] public EventCallback<MoveNode?> OnNodeSelected { get; set; }

    private const int IndentWidth = 16;

    private async Task OnNodeClick(MoveNode? node)
    {
        await OnNodeSelected.InvokeAsync(node);
    }

    private bool IsCurrentNode(MoveNode? node)
    {
        if (node is null)
        {
            return DisplayMoveIndex == 0;
        }

        if (MoveHistory is null || node.Depth > DisplayMoveIndex)
        {
            return false;
        }

        if (node.Depth != DisplayMoveIndex)
        {
            return false;
        }

        var nodePath = node.GetMoves();
        for (int i = 0; i < nodePath.Count && i < MoveHistory.Count; i++)
        {
            if (!MoveNode.IsSameMove(nodePath[i], MoveHistory[i]))
            {
                return false;
            }
        }
        return true;
    }

    private record NodeInfo(MoveNode? Node, bool IsStart, bool IsBranchStart);
    private record Branch(int IndentLevel, List<NodeInfo> Nodes);

    private List<Branch> BuildBranches()
    {
        if (MoveTree is null) return [];

        var branches = new List<Branch>();

        // メインブランチ（開始局面 + メインライン）
        var mainNodes = new List<NodeInfo> { new(null, true, false) };
        CollectMainLine(MoveTree.RootChildren, mainNodes);
        branches.Add(new Branch(0, mainNodes));

        // サブブランチを収集
        CollectSubBranches(MoveTree.RootChildren, 1, branches);

        return branches;
    }

    private void CollectMainLine(IReadOnlyList<MoveNode> nodes, List<NodeInfo> result)
    {
        if (nodes.Count == 0) return;

        // 最初の子がメインライン
        var mainNode = nodes[0];
        result.Add(new NodeInfo(mainNode, false, false));

        // 再帰的にメインラインを辿る
        CollectMainLine(mainNode.Children, result);
    }

    private void CollectSubBranches(IReadOnlyList<MoveNode> nodes, int indentLevel, List<Branch> branches)
    {
        for (int i = 0; i < nodes.Count; i++)
        {
            var node = nodes[i];

            if (i > 0)
            {
                // 2番目以降は分岐
                var branchNodes = new List<NodeInfo> { new(node, false, true) };
                CollectMainLine(node.Children, branchNodes);
                branches.Add(new Branch(indentLevel, branchNodes));

                // この分岐内のさらなるサブブランチを収集
                CollectSubBranches(node.Children, indentLevel + 1, branches);
            }
            else
            {
                // メインラインの子ノードからのサブブランチ
                CollectSubBranches(node.Children, indentLevel, branches);
            }
        }
    }
}
