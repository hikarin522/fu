@using Fu.Core.Models

<div class="move-tree-view">
    @if (MoveTree is not null)
    {
        var treeData = BuildTreeData();
        var graphWidth = (treeData.MaxColumn + 1) * ColumnWidth + 10;

        @foreach (var row in treeData.Rows)
        {
            <div class="tree-row">
                <svg class="tree-graph" width="@graphWidth" height="@RowHeight">
                    @foreach (var col in row.Columns)
                    {
                        var x = col.Column * ColumnWidth + ColumnWidth / 2;
                        var cy = RowHeight / 2;

                        @if (col.HasNode)
                        {
                            @if (col.LineFromTop)
                            {
                                <line x1="@x" y1="0" x2="@x" y2="@cy" stroke="@col.Color" stroke-width="2" />
                            }
                            @if (col.LineToBottom)
                            {
                                <line x1="@x" y1="@cy" x2="@x" y2="@RowHeight" stroke="@col.Color" stroke-width="2" />
                            }
                            <circle cx="@x" cy="@cy" r="5"
                                    fill="@(col.IsCurrent ? HighlightColor : BackgroundColor)"
                                    stroke="@(col.IsCurrent ? HighlightColor : col.Color)"
                                    stroke-width="2" />
                        }
                        else if (col.PassThrough)
                        {
                            <line x1="@x" y1="0" x2="@x" y2="@RowHeight" stroke="@col.Color" stroke-width="2" />
                        }

                        @foreach (var branch in col.ChildBranches)
                        {
                            var targetX = branch.Column * ColumnWidth + ColumnWidth / 2;
                            <path d="M @x @cy Q @x @(cy + 8), @(x + 8) @(cy + 8) L @(targetX - 8) @(cy + 8) Q @targetX @(cy + 8), @targetX @RowHeight"
                                  stroke="@branch.Color" stroke-width="2" fill="none" />
                        }
                    }
                </svg>

                <div class="tree-node @(row.IsCurrent ? "current" : "")"
                     @onclick="() => OnNodeSelected.InvokeAsync(row.Node)"
                     title="@(row.Node?.Move.ToNotationWithFrom() ?? "")">
                    <span>@row.Label</span>
                </div>

                @if (ShowActionButtons && row.IsCurrent)
                {
                    <div class="tree-row-actions">
                        @if (ShowReviewButton)
                        {
                            <button class="btn-tiny btn-review" @onclick="() => OnReviewFromHere.InvokeAsync(row.Node)" title="ここから検討">
                                🔍
                            </button>
                        }
                        @if (ShowRematchButton)
                        {
                            <button class="btn-tiny btn-rematch" @onclick="() => OnRematchFromHere.InvokeAsync(row.Node)" title="ここから再戦">
                                ⚔️
                            </button>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public MoveTree? MoveTree { get; set; }
    [Parameter] public IReadOnlyList<Move>? MoveHistory { get; set; }
    [Parameter] public int DisplayMoveIndex { get; set; }
    [Parameter] public EventCallback<MoveNode?> OnNodeSelected { get; set; }
    [Parameter] public bool ShowActionButtons { get; set; }
    [Parameter] public bool ShowReviewButton { get; set; }
    [Parameter] public bool ShowRematchButton { get; set; }
    [Parameter] public EventCallback<MoveNode?> OnReviewFromHere { get; set; }
    [Parameter] public EventCallback<MoveNode?> OnRematchFromHere { get; set; }

    private const int ColumnWidth = 20;
    private const int RowHeight = 24;
    private const string HighlightColor = "#0078d4";
    private const string BackgroundColor = "#1e1e1e";

    private static readonly string[] BranchColors = ["#4ec9b0", "#ce9178", "#dcdcaa", "#c586c0", "#9cdcfe", "#d16969"];

    private TreeData BuildTreeData()
    {
        if (MoveTree is null) return new([], 0);

        var branches = CollectAllBranches();
        var rows = BuildRows(branches);
        var maxColumn = branches.Count > 0 ? branches.Max(b => b.Column) : 0;

        return new(rows, maxColumn);
    }

    private List<Branch> CollectAllBranches()
    {
        var branches = new List<Branch>();
        var mainBranch = new Branch(0, null, null, BranchColors[0]);
        branches.Add(mainBranch);

        mainBranch.Nodes.Add(new(null, 0));

        var rowIndex = 1;
        // 開始局面（row=0）から分岐する
        CollectBranchNodes(MoveTree!.RootChildren, mainBranch, branches, ref rowIndex, 1, 0);

        return branches;
    }

    private void CollectBranchNodes(IReadOnlyList<MoveNode> nodes, Branch currentBranch, List<Branch> allBranches, ref int rowIndex, int nextColumn, int parentRow)
    {
        for (var i = 0; i < nodes.Count; i++)
        {
            var node = nodes[i];

            if (i == 0)
            {
                var currentRow = rowIndex++;
                currentBranch.Nodes.Add(new(node, currentRow));
                // 子ノードの親行は現在のノードの行
                CollectBranchNodes(node.Children, currentBranch, allBranches, ref rowIndex, nextColumn, currentRow);
            }
            else
            {
                // 分岐点は親ノードの行（この nodes を持っているノードの行）
                var color = BranchColors[allBranches.Count % BranchColors.Length];
                var newBranch = new Branch(nextColumn, currentBranch, parentRow, color);
                allBranches.Add(newBranch);

                var currentRow = rowIndex++;
                newBranch.Nodes.Add(new(node, currentRow));
                CollectBranchNodes(node.Children, newBranch, allBranches, ref rowIndex, nextColumn + 1, currentRow);
            }
        }
    }

    private List<RowData> BuildRows(List<Branch> branches)
    {
        var allNodes = branches
            .SelectMany(b => b.Nodes.Select(n => (n.Node, n.Row, Branch: b)))
            .OrderBy(x => x.Row)
            .ToList();

        return allNodes.Select(x => BuildRow(x.Node, x.Row, x.Branch, branches)).ToList();
    }

    private RowData BuildRow(MoveNode? node, int row, Branch nodeBranch, List<Branch> branches)
    {
        var isCurrent = IsCurrentNode(node);
        var columns = branches
            .Select(b => BuildColumnData(b, row, nodeBranch, branches))
            .Where(c => c is not null)
            .Cast<ColumnData>()
            .OrderBy(c => c.Column)
            .ToList();

        var label = node is null ? "開始局面" : $"{node.Depth}. {node.Move.ToNotationWithFrom()}";
        return new(node, isCurrent, label, columns);
    }

    private ColumnData? BuildColumnData(Branch branch, int row, Branch nodeBranch, List<Branch> branches)
    {
        var (firstRow, lastRow) = (branch.Nodes[0].Row, branch.Nodes[^1].Row);
        var isActive = row >= firstRow && row <= lastRow;
        var hasNode = branch == nodeBranch && branch.Nodes.Any(n => n.Row == row);

        if (!isActive && !hasNode) return null;

        var childBranches = hasNode
            ? branches.Where(b => b.Parent == branch && b.BranchPointRow == row)
                      .Select(b => new ChildBranchData(b.Column, b.Color))
                      .ToList()
            : [];

        return new(
            branch.Column,
            branch.Color,
            hasNode,
            hasNode && IsCurrentNode(branch.Nodes.First(n => n.Row == row).Node),
            hasNode && row > firstRow,
            hasNode && row < lastRow,
            isActive && !hasNode,
            childBranches
        );
    }

    private bool IsCurrentNode(MoveNode? node)
    {
        if (node is null) return DisplayMoveIndex == 0;
        if (MoveHistory is null || node.Depth != DisplayMoveIndex) return false;

        var nodePath = node.GetMoves();
        return !nodePath.Where((move, i) => i < MoveHistory.Count && !MoveNode.IsSameMove(move, MoveHistory[i])).Any();
    }

    private record ChildBranchData(int Column, string Color);
    private record ColumnData(int Column, string Color, bool HasNode, bool IsCurrent, bool LineFromTop, bool LineToBottom, bool PassThrough, List<ChildBranchData> ChildBranches);
    private record RowData(MoveNode? Node, bool IsCurrent, string Label, List<ColumnData> Columns);
    private record TreeData(List<RowData> Rows, int MaxColumn);
    private record NodeData(MoveNode? Node, int Row);

    private class Branch(int column, Branch? parent, int? branchPointRow, string color)
    {
        public int Column { get; } = column;
        public Branch? Parent { get; } = parent;
        public int? BranchPointRow { get; } = branchPointRow;
        public string Color { get; } = color;
        public List<NodeData> Nodes { get; } = [];
    }
}
