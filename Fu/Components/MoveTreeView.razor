@using Fu.Core.Models

<div class="move-tree-view">
    @if (MoveTree is not null)
    {
        var treeData = BuildTreeData();
        var graphWidth = (treeData.MaxColumn + 1) * ColumnWidth + 10;

        @foreach (var row in treeData.Rows)
        {
            <div class="tree-row">
                <svg class="tree-graph" width="@graphWidth" height="@RowHeight">
                    @* 各列の縦線と分岐を描画 *@
                    @foreach (var col in row.Columns)
                    {
                        var x = col.ColumnIndex * ColumnWidth + ColumnWidth / 2;
                        var cy = RowHeight / 2;

                        @if (col.HasNode)
                        {
                            @* ノードがある列 *@
                            @if (col.LineFromTop)
                            {
                                <line x1="@x" y1="0" x2="@x" y2="@cy" stroke="@col.Color" stroke-width="2" />
                            }
                            @if (col.LineToBottom)
                            {
                                <line x1="@x" y1="@cy" x2="@x" y2="@RowHeight" stroke="@col.Color" stroke-width="2" />
                            }
                            <circle cx="@x" cy="@cy" r="5"
                                    fill="@(col.IsCurrentNode ? "#0078d4" : "#1e1e1e")"
                                    stroke="@(col.IsCurrentNode ? "#0078d4" : col.Color)"
                                    stroke-width="2" />
                        }
                        else if (col.PassThrough)
                        {
                            @* 通過する縦線のみ *@
                            <line x1="@x" y1="0" x2="@x" y2="@RowHeight" stroke="@col.Color" stroke-width="2" />
                        }

                        @* この位置から分岐する線 *@
                        @foreach (var branch in col.BranchesToDraw)
                        {
                            var targetX = branch.TargetColumn * ColumnWidth + ColumnWidth / 2;
                            <path d="M @x @cy Q @x @(cy + 8), @(x + 8) @(cy + 8) L @(targetX - 8) @(cy + 8) Q @targetX @(cy + 8), @targetX @RowHeight"
                                  stroke="@branch.Color" stroke-width="2" fill="none" />
                        }
                    }
                </svg>

                <div class="tree-node @(row.IsCurrentNode ? "current" : "")"
                     @onclick="() => OnNodeClick(row.Node)"
                     title="@(row.Node?.Move.ToNotationWithFrom() ?? "")">
                    @if (row.IsStart)
                    {
                        <span>開始局面</span>
                    }
                    else if (row.Node is not null)
                    {
                        <span>@(row.Node.Depth). @row.Node.Move.ToNotationWithFrom()</span>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public MoveTree? MoveTree { get; set; }
    [Parameter] public IReadOnlyList<Move>? MoveHistory { get; set; }
    [Parameter] public int DisplayMoveIndex { get; set; }
    [Parameter] public EventCallback<MoveNode?> OnNodeSelected { get; set; }

    private const int ColumnWidth = 20;
    private const int RowHeight = 24;

    private static readonly string[] BranchColors = [
        "#4ec9b0", "#ce9178", "#dcdcaa", "#c586c0", "#9cdcfe", "#d16969"
    ];

    private async Task OnNodeClick(MoveNode? node) => await OnNodeSelected.InvokeAsync(node);

    private bool IsCurrentNode(MoveNode? node)
    {
        if (node is null) return DisplayMoveIndex == 0;
        if (MoveHistory is null || node.Depth != DisplayMoveIndex) return false;

        var nodePath = node.GetMoves();
        for (int i = 0; i < nodePath.Count && i < MoveHistory.Count; i++)
        {
            if (!MoveNode.IsSameMove(nodePath[i], MoveHistory[i])) return false;
        }
        return true;
    }

    private record BranchLine(int TargetColumn, string Color);
    private record ColumnData(int ColumnIndex, string Color, bool HasNode, bool IsCurrentNode, bool LineFromTop, bool LineToBottom, bool PassThrough, List<BranchLine> BranchesToDraw);
    private record RowData(MoveNode? Node, bool IsStart, bool IsCurrentNode, List<ColumnData> Columns);
    private record TreeData(List<RowData> Rows, int MaxColumn);

    private TreeData BuildTreeData()
    {
        if (MoveTree is null) return new TreeData([], 0);

        // ブランチを収集
        var branches = new List<BranchInfo>();
        var mainBranch = new BranchInfo(0, null, 0, BranchColors[0]);
        branches.Add(mainBranch);

        // 開始局面を追加
        mainBranch.Nodes.Add((null, 0)); // (node, rowIndex)

        // メインラインを収集
        int rowIndex = 1;
        CollectBranch(MoveTree.RootChildren, mainBranch, branches, ref rowIndex, 1);

        // 行データを構築
        var allNodes = new List<(MoveNode? Node, int RowIndex, BranchInfo Branch)>();
        foreach (var branch in branches)
        {
            foreach (var (node, ri) in branch.Nodes)
            {
                allNodes.Add((node, ri, branch));
            }
        }

        // 行インデックスでソート
        allNodes = allNodes.OrderBy(x => x.RowIndex).ToList();

        var rows = new List<RowData>();
        int maxColumn = branches.Max(b => b.Column);

        foreach (var (node, ri, nodeBranch) in allNodes)
        {
            var isStart = node is null;
            var isCurrentNode = IsCurrentNode(node);
            var columns = new List<ColumnData>();

            // 各ブランチについて、この行での状態を計算
            foreach (var branch in branches)
            {
                var nodeInBranch = branch.Nodes.FirstOrDefault(n => n.RowIndex == ri);
                var hasNode = nodeInBranch != default && branch == nodeBranch;

                // ブランチがこの行でアクティブか
                var branchFirstRow = branch.Nodes.Min(n => n.RowIndex);
                var branchLastRow = branch.Nodes.Max(n => n.RowIndex);
                var isActive = ri >= branchFirstRow && ri <= branchLastRow;

                if (!isActive && !hasNode) continue;

                var passThrough = isActive && !hasNode;
                var lineFromTop = hasNode && ri > branchFirstRow;
                var lineToBottom = hasNode && ri < branchLastRow;

                // この行から分岐する子ブランチを検索
                var branchesToDraw = new List<BranchLine>();
                if (hasNode)
                {
                    foreach (var childBranch in branches)
                    {
                        if (childBranch.ParentBranch == branch && childBranch.BranchPointRow == ri)
                        {
                            branchesToDraw.Add(new BranchLine(childBranch.Column, childBranch.Color));
                        }
                    }
                }

                columns.Add(new ColumnData(
                    branch.Column,
                    branch.Color,
                    hasNode,
                    hasNode && isCurrentNode,
                    lineFromTop,
                    lineToBottom,
                    passThrough,
                    branchesToDraw
                ));
            }

            // 列をソート
            columns = columns.OrderBy(c => c.ColumnIndex).ToList();

            rows.Add(new RowData(node, isStart, isCurrentNode, columns));
        }

        return new TreeData(rows, maxColumn);
    }

    private class BranchInfo
    {
        public int Column { get; }
        public BranchInfo? ParentBranch { get; }
        public int? BranchPointRow { get; }
        public string Color { get; }
        public List<(MoveNode? Node, int RowIndex)> Nodes { get; } = [];

        public BranchInfo(int column, BranchInfo? parentBranch, int? branchPointRow, string color)
        {
            Column = column;
            ParentBranch = parentBranch;
            BranchPointRow = branchPointRow;
            Color = color;
        }
    }

    private void CollectBranch(IReadOnlyList<MoveNode> nodes, BranchInfo currentBranch, List<BranchInfo> allBranches, ref int rowIndex, int nextColumn)
    {
        for (int i = 0; i < nodes.Count; i++)
        {
            var node = nodes[i];

            if (i == 0)
            {
                // メインライン: 現在のブランチに追加
                currentBranch.Nodes.Add((node, rowIndex));
                var currentRow = rowIndex;
                rowIndex++;

                // 子ノードを処理
                CollectBranch(node.Children, currentBranch, allBranches, ref rowIndex, nextColumn);
            }
            else
            {
                // 分岐: 新しいブランチを作成
                var parentRow = currentBranch.Nodes.Last().RowIndex;
                var color = BranchColors[allBranches.Count % BranchColors.Length];
                var newBranch = new BranchInfo(nextColumn, currentBranch, parentRow, color);
                allBranches.Add(newBranch);

                newBranch.Nodes.Add((node, rowIndex));
                rowIndex++;

                // 子ノードを処理
                CollectBranch(node.Children, newBranch, allBranches, ref rowIndex, nextColumn + 1);
            }
        }
    }
}
