<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <ItemGroup>
    <ProjectReference Include="..\Fu.Core\Fu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" PrivateAssets="all" />
  </ItemGroup>

  <!-- Download external libraries not available via libman -->
  <Target Name="DownloadExternalLibraries" BeforeTargets="Build">
    <PropertyGroup>
      <YaneuraOuDir>$(MSBuildProjectDirectory)/wwwroot/lib/yaneuraou</YaneuraOuDir>
      <CoiServiceWorkerFile>$(MSBuildProjectDirectory)/wwwroot/coi-serviceworker.min.js</CoiServiceWorkerFile>
    </PropertyGroup>

    <MakeDir Directories="$(YaneuraOuDir)" Condition="!Exists('$(YaneuraOuDir)')" />

    <DownloadFile
      SourceUrl="https://unpkg.com/yaneuraou.wasm@0.1.2/yaneuraou.js"
      DestinationFolder="$(YaneuraOuDir)"
      SkipUnchangedFiles="true"
      Condition="!Exists('$(YaneuraOuDir)/yaneuraou.js')" />

    <DownloadFile
      SourceUrl="https://unpkg.com/yaneuraou.wasm@0.1.2/yaneuraou.wasm"
      DestinationFolder="$(YaneuraOuDir)"
      SkipUnchangedFiles="true"
      Condition="!Exists('$(YaneuraOuDir)/yaneuraou.wasm')" />

    <DownloadFile
      SourceUrl="https://unpkg.com/coi-serviceworker@0.1.7/coi-serviceworker.min.js"
      DestinationFolder="$(MSBuildProjectDirectory)/wwwroot"
      SkipUnchangedFiles="true"
      Condition="!Exists('$(CoiServiceWorkerFile)')" />
  </Target>

</Project>
