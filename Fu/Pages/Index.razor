@page "/"
@page "/{RoomIdParam?}"

<div class="game-page">
    <header class="game-header">
        <h1>Fu - 将棋</h1>
        <div class="game-info">
            @switch (CurrentGameState.Status)
            {
                case GameStatus.Playing:
                    <span class="turn-indicator @(CurrentGameState.IsMyTurn ? "my-turn" : "opponent-turn")">
                        @(CurrentGameState.IsMyTurn ? "あなたの番です" : "相手の番です")
                    </span>
                    @if (GameService?.IsInCheck() ?? false)
                    {
                        <span class="check-indicator">王手!</span>
                    }
                    break;
                case GameStatus.Reviewing:
                    <span class="turn-indicator review-mode">
                        検討中 - @(CurrentGameState.CurrentTurn == Turn.First ? "先手" : "後手")番
                    </span>
                    break;
                case var status when status.GetResultMessage() is { } message:
                    <span class="game-result">@message</span>
                    break;
            }
        </div>
    </header>

    <main class="game-main">
        @if (NeedsReload)
        {
            <div class="loading-message">
                <div class="spinner"></div>
                <p>評価機能を有効化中...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(InitError))
        {
            <div class="error-message">初期化エラー: @InitError</div>
        }
        else if (!Lobby.IsConnected)
        {
            <ConnectionPanel
                OnConnected="StateHasChanged"
                InitialRoomId="@RoomIdParam"
                BaseUrl="@BaseUrl" />
        }
        else if (ShowNewGameDialog)
        {
            <div class="new-game-dialog">
                <h3>新規対局</h3>
                <p>対局者を選択してください</p>

                <div class="player-select-section">
                    <label>先手:</label>
                    <select @bind="SelectedFirstPlayerIdString">
                        <option value="">-- 選択 --</option>
                        @foreach (var p in Lobby.Participants)
                        {
                            <option value="@p.PlayerId.AsPrimitive()">@p.Nickname @(p.PlayerId == Lobby.MyPlayerId ? "(自分)" : "")</option>
                        }
                    </select>
                </div>

                <div class="player-select-section">
                    <label>後手:</label>
                    <select @bind="SelectedSecondPlayerIdString">
                        <option value="">-- 選択 --</option>
                        @foreach (var p in Lobby.Participants)
                        {
                            <option value="@p.PlayerId.AsPrimitive()">@p.Nickname @(p.PlayerId == Lobby.MyPlayerId ? "(自分)" : "")</option>
                        }
                    </select>
                </div>

                <div class="option-section">
                    <div class="option-title">対局者への評価表示</div>
                    <small class="option-hint">※観戦者には常にすべて表示されます</small>
                    <div class="option-checkboxes">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="OptShowAdvantage" />
                            優勢表示
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="OptShowEvaluationValue" />
                            評価値
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="OptShowHasMate" />
                            詰みの有無
                        </label>
                        <label class="checkbox-label" style="margin-left: 20px;">
                            <input type="checkbox" @bind="OptShowMateCount" disabled="@(!OptShowHasMate)" />
                            詰み手数
                        </label>
                    </div>
                </div>

                <div class="dialog-buttons">
                    <button class="btn primary" @onclick="StartNewGameAsync"
                            disabled="@(SelectedFirstPlayerId is null || SelectedSecondPlayerId is null || SelectedFirstPlayerId == SelectedSecondPlayerId)">
                        対局開始
                    </button>
                    <button class="btn" @onclick="() => ShowNewGameDialog = false">キャンセル</button>
                </div>
            </div>
        }
        else
        {
            <div class="game-area">
                <div class="player-info opponent">
                    <span class="player-label">
                        @(IsFlipped ? FirstNickname : SecondNickname)
                        (@(IsFlipped ? "先手" : "後手"))
                    </span>
                    <span class="player-time">
                        @FormatTime(GetPlayerTime(IsFlipped ? Turn.First : Turn.Second))
                    </span>
                </div>

                <ShogiBoard
                    State="CurrentGameState"
                    GameService="GameService"
                    OnMoveMade="OnMoveMade"
                    IsFlipped="IsFlipped"
                    CandidateMoves="@(ShowCandidateArrows ? EngineService.Candidates : null)"
                    CandidateMoveTurn="CurrentGameState.CurrentTurn" />

                <div class="player-info self">
                    <span class="player-label">
                        @(IsFlipped ? SecondNickname : FirstNickname)
                        (@(IsFlipped ? "後手" : "先手"))
                        @if (IsPlayer)
                        {
                            <span>(あなた)</span>
                        }
                    </span>
                    <span class="player-time">
                        @FormatTime(GetPlayerTime(IsFlipped ? Turn.Second : Turn.First))
                    </span>
                </div>

                @if (IsSpectator || IsGameEnded || CurrentGameState.IsReviewing)
                {
                    <div class="spectator-controls">
                        @if (IsSpectator)
                        {
                            <span class="spectator-notice">観戦中</span>
                        }
                        else if (CurrentGameState.IsReviewing)
                        {
                            <span class="spectator-notice">検討中</span>
                        }
                        <button class="btn-small" @onclick="ToggleBoardFlip" title="盤面を反転">
                            🔄 @(IsFlipped ? "後手視点" : "先手視点")
                        </button>
                    </div>
                }
                <div class="participants-list">
                    <span class="participants-label">参加者:</span>
                    @foreach (var (participant, role, isConnected, isMe) in GetAllParticipantsInfo())
                    {
                        <span class="participant-item @(isConnected ? "connected" : "disconnected") @(isMe ? "is-me" : "")">
                            <span class="participant-name">@participant.Nickname</span>
                            <span class="participant-role">@role</span>
                            @if (!isConnected)
                            {
                                <span class="participant-status">切断</span>
                            }
                        </span>
                    }
                </div>
                @if (ShowEvaluation)
                {
                    <EvaluationBar
                        EngineService="EngineService"
                        ShowAdvantage="ShowAdvantage"
                        ShowEvaluationValue="ShowEvaluationValue"
                        ShowHasMate="ShowHasMate"
                        ShowMateCount="ShowMateCount"
                        ShowCandidates="ShowCandidateArrows"
                        ShowMateSequence="CanShowAllEvaluation"
                        Board="DisplayBoard" />
                }

                <div class="game-controls">
                    @if (CurrentGameState.Status == GameStatus.Playing && IsPlayer)
                    {
                        <button class="btn danger" @onclick="ResignAsync">投了</button>
                    }
                    @if (CurrentGameState.Status != GameStatus.Playing)
                    {
                        <button class="btn" @onclick="OpenNewGameDialog">新規対局</button>
                    }
                    <button class="btn-small btn-sound" @onclick="ToggleSoundAsync" title="@(SoundEnabled ? "通知音OFF" : "通知音ON")">
                        @(SoundEnabled ? "🔔" : "🔕")
                    </button>
                </div>
            </div>
        }
    </main>

    @if (Lobby.IsConnected && !ShowNewGameDialog && CurrentGameState.Status != GameStatus.WaitingForConnection && GameService is not null)
    {
    <div class="move-history">
        <div class="move-history-header">
            <h4>棋譜</h4>
            @if (CurrentGameState.MoveHistory.Count > 0)
            {
                <button class="btn-small" @onclick="DownloadKifAsync">保存</button>
            }
        </div>
        <div class="history-navigation">
            @{
                var totalBranches = GameService.GetTotalBranchCount();
                var currentBranch = totalBranches > 1 ? GameService.GetCurrentBranchIndex() + 1 : 1;
            }
            <button class="btn-nav" @onclick="GoToPreviousBranchAsync" disabled="@(totalBranches <= 1)">&lt;</button>
            <span class="move-index">分岐: @currentBranch / @totalBranches</span>
            <button class="btn-nav" @onclick="GoToNextBranchAsync" disabled="@(totalBranches <= 1)">&gt;</button>
        </div>
        @* 検討ボタン群 *@
        @{
            var isReviewing = CurrentGameState.IsReviewing;
            var isGameOver = CurrentGameState.Status.IsGameOver();
            var isReviewMode = CurrentGameState.Status == GameStatus.Reviewing;
            var canResumeFromBranch = CurrentGameState.Status == GameStatus.Playing && !CurrentGameState.IsAtActiveBranchLatest;
        }
        @if (isReviewing || isReviewMode)
        {
            <button class="btn-small btn-latest" @onclick="GoToLatestAsync">最新に戻る</button>
        }
        @if (isReviewing && canResumeFromBranch)
        {
            <button class="btn-small btn-branch" @onclick="ResumeFromBranchAsync">ここから再開</button>
        }
        @if (isReviewing || isReviewMode)
        {
            <button class="btn-small btn-rematch" @onclick="RematchFromCurrentAsync">ここから再戦</button>
            <button class="btn-small btn-review" @onclick="StartReviewFromCurrentAsync">ここから検討</button>
        }
        <MoveTreeView
            MoveTree="GameService.MoveTree"
            MoveHistory="CurrentGameState.DisplayBranchHistory"
            DisplayMoveIndex="CurrentGameState.DisplayMoveIndex"
            OnNodeSelected="OnTreeNodeSelected" />
    </div>
    }
</div>
